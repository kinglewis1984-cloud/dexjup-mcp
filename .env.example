# Solana RPC endpoint. The public default is rate-limited; a Helius/Triton/etc.
# URL is recommended for real use.
RPC_URL=https://api.mainnet-beta.solana.com

# --- Trading (execute_swap) -------------------------------------------------
# Read-only tools (search, quotes, overviews, balance checks) work with none
# of the settings below. Only set these if you want execute_swap to work.

# Must be exactly "true" to allow execute_swap. Unset/false = read-only server,
# and SOLANA_PRIVATE_KEY is never read.
TRADING_ENABLED=false

# Required only when TRADING_ENABLED=true. Either a base58-encoded secret key
# string, or a JSON byte-array string like "[12,34,...]" (same formats a
# Phantom-exported key comes in). Never commit this. Use a wallet with
# limited funds — see SECURITY.md.
# SOLANA_PRIVATE_KEY=

# Hard caps enforced server-side on every execute_swap call, regardless of
# what is requested.
MAX_SOL_PER_SWAP=0.5
MAX_SLIPPAGE_BPS=500
QUOTE_FRESHNESS_SECONDS=30

# Optional: comma-separated mint allow/deny lists.
# ALLOWED_OUTPUT_MINTS=
# DENY_MINTS=

# --- API base URLs (override only if you know you need to) -----------------
DEXSCREENER_BASE_URL=https://api.dexscreener.com
JUPITER_BASE_URL=https://api.jup.ag
